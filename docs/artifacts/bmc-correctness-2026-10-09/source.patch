@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Check BMC symbolic indices and conservative value gates on ILP32/LP64."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+CASES = {
+    0: ("signed index through helper", "FALSE"),
+    1: ("guarded disjoint index", "NO_FALSE"),
+    2: ("unsigned index", "FALSE"),
+    3: ("shared load remains unsupported", "UNKNOWN"),
+    4: ("unrelated nondet name is not a source contract", "UNKNOWN"),
+    5: ("two guarded values must not alias clocks", "FALSE"),
+    6: ("symbolic index and overlapping widths", "FALSE"),
+    7: ("unsigned constant above INT64_MAX", "FALSE"),
+    8: ("narrowing cast remains unsupported", "UNKNOWN"),
+    9: ("machine arithmetic remains unsupported", "UNKNOWN"),
+    10: ("unrelated nondet guard remains unsupported", "UNKNOWN"),
+    11: ("out-of-object symbolic access is not confirmed", "UNKNOWN"),
+    12: ("signed-to-unsigned bitcast preserves bits", "FALSE"),
+    14: ("old-style C nondet declaration", "FALSE"),
+}
+
+
+def verdict(text):
+    if "The program is definitely UNSAFE" in text:
+        return "FALSE"
+    if "The program is potentially UNSAFE" in text or "The program is UNKNOWN" in text:
+        return "UNKNOWN"
+    if "The program is SAFE" in text:
+        return "TRUE"
+    return "ERROR"
+
+
+def main():
+    here = Path(__file__).resolve().parent
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ikos", type=Path,
+                        default=here.parents[3] / "install/bin/ikos")
+    parser.add_argument("--bits", choices=["32", "64"])
+    args = parser.parse_args()
+    ikos = args.ikos.resolve()
+    env = dict(os.environ, IKOS_BMC_RECOVER="1")
+    failures = 0
+    with tempfile.TemporaryDirectory(prefix="ikos-bmc-address-") as tmp:
+        work = Path(tmp)
+        # A renamed source checks that the behavior does not depend on fixture names.
+        source = work / "renamed-input.c"
+        source.write_text((here / "address.c").read_text())
+        for bits in ([args.bits] if args.bits else ["32", "64"]):
+            for case, (name, expected) in CASES.items():
+                cmd = [str(ikos), "--analyses=race", "--concurrency=auto",
+                       "--demote-race-to-unknown", "-m", bits,
+                       "-D", f"CASE={case}", "-o", str(work / "output.db"),
+                       str(source)]
+                try:
+                    proc = subprocess.run(cmd, cwd=work, env=env,
+                                          capture_output=True, text=True, timeout=30)
+                    actual = verdict(proc.stdout + proc.stderr)
+                    ok = proc.returncode == 0 and (
+                        actual in ("TRUE", "UNKNOWN") if expected == "NO_FALSE"
+                        else actual == expected)
+                except subprocess.TimeoutExpired:
+                    actual, ok = "TIMEOUT", False
+                    proc = None
+                print(f"{bits}-bit {name}: {actual} [{'PASS' if ok else 'FAIL'}]",
+                      flush=True)
+                if not ok:
+                    failures += 1
+                    if proc is not None:
+                        print(proc.stdout + proc.stderr)
+    raise SystemExit(1 if failures else 0)
+
+
+if __name__ == "__main__":
+    main()
